{
  "name": "lumiq-admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 4250",
    "start": "next start --hostname 127.0.0.1 --port 4250",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test ../../scripts/tests/admin-boundary.test.mjs ../../scripts/tests/contracts-sync.test.mjs && vitest run",
