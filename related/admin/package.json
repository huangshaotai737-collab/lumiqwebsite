    "test:boundaries": "node --test ../../scripts/tests/admin-boundary.test.mjs ../../scripts/tests/contracts-sync.test.mjs",
    "test:e2e:operations": "playwright test -c playwright.operations.config.ts",
    "test:e2e:catalog": "playwright test -c playwright.catalog.config.ts"
  },
  "dependencies": {
    "@formatjs/icu-messageformat-parser": "3.5.17",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "next": "16.4.2",
    "nodemailer": "10.1.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
