# 配置认证服务后，仍须数据库中有效的员工身份才能进入后台。可公开的项目 URL 与 publishable key：
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 以下仅限服务器；不得使用 NEXT_PUBLIC_ 前缀或提交真实值。
SUPABASE_SECRET_KEY=

# Site origin (no path/trailing slash). Server-side shared HMAC salt: at least 32 characters.
APP_ORIGIN=
REQUEST_LIMIT_SALT=
# Optional trusted ingress header: x-real-ip or x-vercel-forwarded-for.
# Ingress must overwrite it and block direct access. Empty shares one conservative bucket.
REQUEST_IP_HEADER=

# Private SMTP transport for team invitations. 465=TLS; remote other ports require STARTTLS.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
STAFF_INVITE_FROM=

# Required for media completion (Node runtime): operator-provisioned absolute ffprobe path.
# No binary is bundled or assumed to exist on the deployment host.
MEDIA_FFPROBE_PATH=
# Required: operator-confirmed global Supabase Storage cap in bytes.
# The app intersects this with each live private bucket limit and the 20/50 MiB app caps.
MEDIA_STORAGE_MAX_BYTES=

# Trusted website origin for staff preview entry (never CMS siteUrl).
WEBSITE_ORIGIN=
