SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Site origin (no path/trailing slash). Server-side shared HMAC salt: at least 32 characters.
APP_ORIGIN=
# Exact staff-admin origin allowed to embed authenticated visual content previews.
# Leave empty to disable embedded editing; saved staff previews remain available.
ADMIN_ORIGIN=
REQUEST_LIMIT_SALT=
# Optional trusted ingress header: x-real-ip or x-vercel-forwarded-for.
# Ingress must overwrite it and block direct access. Empty shares one conservative bucket.
REQUEST_IP_HEADER=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
